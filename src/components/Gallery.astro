---
import { painter, paintings } from "../data/site";
---

<figure class="gallery" data-gallery aria-roledescription="carousel" aria-label="Paintings">
    <div class="frame">
        {paintings.map((p, i) => (
            <img
                class:list={["slide", { "is-active": i === 0 }]}
                src={p.src}
                width={p.width}
                height={p.height}
                alt={p.alt}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                draggable="false"
            />
        ))}
    </div>
    <figcaption class="caption">
        <div class="titles" aria-live="polite">
            {paintings.map((p, i) => (
                <span class="title" hidden={i !== 0}>
                    {p.title}, {p.year} -
                    <span class="credit">
                        <a href={painter.href} target="_blank" rel="noopener">{painter.name}</a>
                    </span>
                </span>
            ))}
        </div>
        <!-- shown by the script, so without it the first painting stands alone -->
        <div class="controls" hidden>
            <button type="button" data-step="-1" aria-label="Previous painting">&larr;</button>
            <span class="count" data-count>1 / {paintings.length}</span>
            <button type="button" data-step="1" aria-label="Next painting">&rarr;</button>
        </div>
    </figcaption>
</figure>

<script>
    const SWIPE = 40;

    function setup(root: HTMLElement) {
        const slides = [...root.querySelectorAll<HTMLElement>(".slide")];
        const titles = [...root.querySelectorAll<HTMLElement>(".title")];
        const controls = root.querySelector<HTMLElement>(".controls");
        const count = root.querySelector<HTMLElement>("[data-count]");
        if (slides.length < 2 || !controls) return;

        let current = 0;
        const show = (next: number) => {
            current = (next + slides.length) % slides.length;
            slides.forEach((s, i) => s.classList.toggle("is-active", i === current));
            titles.forEach((t, i) => (t.hidden = i !== current));
            if (count) count.textContent = `${current + 1} / ${slides.length}`;
        };

        controls.hidden = false;
        controls.addEventListener("click", (e) => {
            const button = (e.target as HTMLElement).closest<HTMLElement>("[data-step]");
            if (button) show(current + Number(button.dataset.step));
        });

        root.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") show(current - 1);
            else if (e.key === "ArrowRight") show(current + 1);
        });

        let startX: number | null = null;
        const frame = root.querySelector<HTMLElement>(".frame")!;
        frame.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
        frame.addEventListener("touchend", (e) => {
            if (startX === null) return;
            const dx = e.changedTouches[0].clientX - startX;
            startX = null;
            if (Math.abs(dx) > SWIPE) show(current + (dx < 0 ? 1 : -1));
        });
    }

    // page-load fires on first load and after every client-side navigation
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(setup);
    });
</script>

<style>
    .gallery {
        margin: 0;
    }

    /* every painting shares one cell, so the frame never changes height */
    .frame {
        display: grid;
        touch-action: pan-y;
    }
    .slide {
        grid-area: 1 / 1;
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.35s ease;
    }
    .slide.is-active {
        opacity: 1;
    }

    .caption {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25rem 1rem;
    }

    .controls {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        flex: none;
    }
    .controls[hidden] {
        display: none;
    }
    .count {
        font-variant-numeric: tabular-nums;
    }
    .controls button {
        padding: 0 0.25rem;
        border: 0;
        background: none;
        font: inherit;
        font-size: 1rem;
        line-height: 1;
        color: var(--ink);
        cursor: pointer;
        transition: color 0.15s ease;
    }
    .controls button:hover {
        color: var(--accent);
    }
</style>

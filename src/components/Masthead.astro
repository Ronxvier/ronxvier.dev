---
// Full nameplate on the front page, a compact one on every other page.
import { socials } from "../data/site";

const { compact = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const sections = [
    { name: "Home", href: "/" },
    { name: "Projects", href: "/projects" },
    { name: "Archive", href: "/archive" },
    { name: "About", href: "/about" },
];

const isCurrent = (href: string) =>
    href === "/" ? path === "/" : path === href || path.startsWith(href + "-") || path.startsWith(href + "/");

const today = new Date().toLocaleDateString("en-US", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
});
const github = socials.find((s) => s.name === "Github")!;
---

<header class:list={["masthead", { compact }]} transition:name="masthead">
    <div class="wrap">
        {!compact && (
            <div class="folio">
                <time class="folio-date" id="folio-date">{today}</time>
                <span class="folio-site">ronxvier.dev</span>
                <a class="folio-link" href={github.href} target="_blank" rel="noopener">Github</a>
            </div>
        )}

        <a href="/" class="nameplate" aria-label="Ronel Xavier, home">Ronel Xavier</a>

        <nav class="sections" aria-label="Sections">
            <ul>
                {sections.map((s) => (
                    <li>
                        <a href={s.href} aria-current={isCurrent(s.href) ? "page" : undefined}>
                            {s.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<script>
    // the page is static, so refresh the build-time date to the reader's today
    document.addEventListener("astro:page-load", () => {
        const el = document.getElementById("folio-date");
        if (el) {
            el.textContent = new Date().toLocaleDateString("en-US", {
                weekday: "long",
                year: "numeric",
                month: "long",
                day: "numeric",
            });
        }
    });
</script>

<style>
    .masthead {
        padding-top: 0.75rem;
    }

    .folio {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        font-family: var(--sans);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ink);
    }
    .folio-site {
        color: var(--muted);
        font-weight: 500;
    }
    .folio-link {
        justify-self: end;
    }
    .nameplate {
        display: block;
        margin: 0.5rem 0 0.9rem;
        text-align: center;
        font-family: var(--blackletter);
        font-size: clamp(3rem, 9vw, 5.75rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0.005em;
        text-decoration: none;
    }

    /* the double rule under the nameplate */
    .sections {
        border-top: 1px solid var(--rule-heavy);
        border-bottom: 1px solid var(--rule-heavy);
        padding: 3px 0 0;
        position: relative;
    }
    .sections::before {
        content: "";
        position: absolute;
        top: 3px;
        left: 0;
        right: 0;
        border-top: 1px solid var(--rule-heavy);
    }

    .sections ul {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0 2rem;
        margin: 0;
        padding: 0.55rem 0 0.5rem;
        list-style: none;
    }

    .sections a {
        font-family: var(--sans);
        font-size: 0.8125rem;
        font-weight: 600;
    }
    /* the current section keeps a heavier accent underline */
    .sections a[aria-current="page"] {
        text-decoration-color: var(--accent);
        text-decoration-thickness: 2px;
    }

    /* inner pages: nameplate shrinks, sits left of the nav on wide screens */
    .compact .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 0.6rem;
    }
    .compact .nameplate {
        margin: 0;
        font-size: 2.1rem;
        text-align: left;
    }
    .compact .sections {
        border: 0;
        padding: 0;
    }
    .compact .sections::before {
        display: none;
    }
    .compact .sections ul {
        gap: 0 1.5rem;
        padding: 0;
    }

    @media (max-width: 640px) {
        .folio {
            grid-template-columns: 1fr auto;
        }
        .folio-site {
            display: none;
        }
        .sections ul {
            gap: 0 1.25rem;
        }
        .compact .wrap {
            flex-direction: column;
            align-items: center;
            gap: 0.4rem;
        }
        .compact .nameplate {
            font-size: 1.9rem;
        }
    }
</style>

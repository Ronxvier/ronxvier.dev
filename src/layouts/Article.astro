---
import Base from "./Base.astro";

const { title, kicker, kickerHref, deck, byline = true, wide = false } = Astro.props;
---

<Base title={title}>
    <article class:list={["article", "wrap", { wide }]}>
        <header class="article-head">
            {kicker && (kickerHref ? <a class="kicker" href={kickerHref}>{kicker}</a> : <span class="kicker">{kicker}</span>)}
            <h1 class="hed article-hed">{title}</h1>
            {deck && <p class="article-deck">{deck}</p>}
            {byline && <p class="byline">By Ronel Xavier</p>}
        </header>
        <div class="article-body">
            <slot />
        </div>
    </article>
</Base>

<style>
    .article {
        padding-top: 2.5rem;
    }
    .article-head,
    .article-body {
        max-width: var(--measure);
        margin: 0 auto;
    }
    .wide .article-head,
    .wide .article-body {
        max-width: 52rem;
    }

    .article-head {
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--rule);
    }
    .article-hed {
        font-size: clamp(2.1rem, 5vw, 3rem);
        font-weight: 500;
        line-height: 1.08;
        letter-spacing: -0.015em;
    }
    .article-deck {
        margin: 0.75rem 0 0;
        font-size: 1.3rem;
        line-height: 1.4;
        color: var(--ink-soft);
    }
    .article-head .byline {
        margin: 1rem 0 0;
    }
</style>

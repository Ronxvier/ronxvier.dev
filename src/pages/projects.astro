---
import Article from "../layouts/Article.astro";
import { research, projects } from "../data/site";

const external = (href?: string) => !!href && href.startsWith("http");
---

<Article title="Projects" byline={false} wide>
    <article class="top">
        <span class="kicker">{research.kind}</span>
        <h2 class="hed top-hed">
            <a href={research.href} target="_blank" rel="noopener">{research.name}</a>
        </h2>
        <p>{research.summary}</p>
        <p>{research.note}</p>
    </article>

    <ul class="index">
        {projects.map((p) => (
            <li class="item">
                <span class="kicker">{p.kind}</span>
                <div>
                    <h2 class="hed item-hed">
                        {p.href ? (
                            <a href={p.href} target={external(p.href) ? "_blank" : undefined} rel={external(p.href) ? "noopener" : undefined}>{p.name}</a>
                        ) : (
                            p.name
                        )}
                    </h2>
                    <p class="summary">{p.summary}</p>
                </div>
            </li>
        ))}
    </ul>

    <p class="more">
        Find more projects on <a href="https://www.github.com/Ronxvier" target="_blank" rel="noopener">Github</a>!
    </p>
</Article>

<style>
    .top {
        padding-bottom: 1.75rem;
        margin-bottom: 0.5rem;
        border-bottom: 2px solid var(--rule-heavy);
    }
    .top-hed {
        font-size: 2rem;
    }
    .top p {
        margin: 0.75rem 0 0;
        max-width: var(--measure);
    }

    .index {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .item {
        display: grid;
        grid-template-columns: 10rem minmax(0, 1fr);
        gap: 0.25rem 1.5rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--rule);
    }
    .item .kicker {
        margin: 0.4rem 0 0;
    }
    .item-hed {
        font-size: 1.4rem;
    }

    .more {
        margin: 1.5rem 0 0;
        font-style: italic;
    }

    @media (max-width: 640px) {
        .item {
            grid-template-columns: 1fr;
        }
        .item .kicker {
            margin: 0;
        }
    }
</style>

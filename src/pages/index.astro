---
import Base from "../layouts/Base.astro";
import { research, socials } from "../data/site";
---

<Base front>
    <div class="wrap">
        <!-- lead story + right rail -->
        <section class="front" aria-label="Top stories">
            <article class="lead">
                <figure>
                    <img
                        src="/img/camille/TAG.png"
                        width="1600"
                        height="1066"
                        alt="painting"
                    />
                    <figcaption class="caption">
                        The Artist's Garden at Eragny, 1898  -
                        <span class="credit">
                            <a
                                href="https://www.nga.gov/artists/1791-camille-pissarro"
                                target="_blank"
                                rel="noopener">Camille Pissarro</a
                            >
                        </span>
                    </figcaption>
                </figure>
                <h1 class="hed lead-hed">Welcome to my dev portfolio</h1>
                <p class="lead-deck">
                    I use this website to keep track of my projects and write small
                    <a href="/archive">blog</a> sections.
                </p>
                <p class="byline">By Ronel Xavier</p>
            </article>

            <aside class="rail">
                <article class="rail-story">
                    <span class="kicker">{research.kind}</span>
                    <h2 class="hed rail-hed">
                        <a href={research.href} target="_blank" rel="noopener">{research.name}</a>
                    </h2>
                    <p class="summary">{research.summary}</p>
                    <p class="summary">{research.note}</p>
                </article>

                <article class="rail-story">
                    <h2 class="hed rail-subhed">Stalk me on</h2>
                    <ul class="elsewhere">
                        {socials.map((s) => (
                            <li><a href={s.href} target="_blank" rel="noopener">{s.name}</a></li>
                        ))}
                    </ul>
                </article>
            </aside>
        </section>

        <!-- about -->
        <section class="block about" aria-labelledby="about-head">
            <header class="section-head">
                <h2 id="about-head"><a href="/about">About</a></h2>
            </header>
            <p class="summary">Under construction. Come back soon!</p>
        </section>
    </div>
</Base>

<style>
    .front {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: 0 2rem;
        padding: 1.5rem 0 2.5rem;
    }

    .lead figure {
        margin: 0;
    }
    .lead img {
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
    }

    .lead-hed {
        margin-top: 1.25rem;
        font-size: clamp(2rem, 4.2vw, 3.1rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.015em;
    }
    .lead-deck {
        margin: 0.75rem 0 0.9rem;
        max-width: 36rem;
        font-size: 1.3rem;
        line-height: 1.4;
        color: var(--ink-soft);
    }
    .lead .byline {
        margin: 0;
    }

    .rail {
        border-left: 1px solid var(--rule);
        padding-left: 2rem;
    }
    .rail-story + .rail-story {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--rule);
    }
    .rail-hed {
        font-size: 1.6rem;
    }
    .rail-subhed {
        font-size: 1.125rem;
    }

    .elsewhere {
        margin: 0.6rem 0 0;
        padding: 0;
        list-style: none;
        font-family: var(--sans);
        font-size: 0.875rem;
        font-weight: 500;
    }
    .elsewhere li {
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--rule);
    }
    .elsewhere li:last-child {
        border-bottom: 0;
    }

    .block {
        padding-top: 1rem;
        padding-bottom: 2rem;
    }

    .about .summary {
        margin: 0;
    }

    @media (max-width: 760px) {
        .front {
            grid-template-columns: 1fr;
        }
        .rail {
            border-left: 0;
            padding-left: 0;
            margin-top: 1.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--rule);
        }
    }
</style>

---
import Article from "../../layouts/Article.astro";
import EntryList from "../../components/EntryList.astro";
import { archive } from "../../data/site";

const section = archive.find((a) => a.name === "Podcasts")!;
---

<Article title="Podcasts" kicker="Archive" kickerHref="/archive" deck={section.deck}>
    <EntryList entries={section.entries} style="review" />
</Article>

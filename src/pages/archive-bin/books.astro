---
import Article from "../../layouts/Article.astro";
import EntryList from "../../components/EntryList.astro";
import { archive } from "../../data/site";

const section = archive.find((a) => a.name === "Books")!;
---

<Article title="Books" kicker="Archive" kickerHref="/archive" deck={section.deck}>
    <EntryList entries={section.entries} style="quote" />
    <p class="disclosure">None of these links are affiliate.</p>
</Article>

<style>
    .disclosure {
        margin: 1.5rem 0 0;
        font-family: var(--sans);
        font-size: 0.8125rem;
        font-style: italic;
        color: var(--muted);
    }
</style>
